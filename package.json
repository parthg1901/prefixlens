{
  "name": "prefixlens",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "author": "Parth",
  "description": "Explains prompt-cache hits and misses for LLM agent harnesses: import session logs, record through a local proxy or a wrapped SDK client, and assert prefix stability in CI.",
  "keywords": [
    "llm",
    "prompt-caching",
    "prompt-cache",
    "cache",
    "anthropic",
    "openai",
    "claude",
    "agents",
    "harness",
    "observability",
    "tracing",
    "cost",
    "ci",
    "testing"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "prefixlens": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./test": "./src/assert.ts",
    "./pricing.json": "./pricing.json"
  },
  "files": [
    "src",
    "pricing.json",
    "SPEC.md",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@types/bun": "^1.4.4",
    "openai": "^7.55.0",
    "typescript": "^7.0.2"
  }
}
